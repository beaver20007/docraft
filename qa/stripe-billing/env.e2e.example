# Copy to .env.e2e (git-ignored) and fill in. Never commit real values.
E2E_API_BASE_URL=https://ai-playbook-generator-production.up.railway.app
# Supabase session access token of the TEST account (expires ~1h, refresh before each run)
E2E_ACCESS_TOKEN=
# Supabase user id (uuid) of the SAME test account
E2E_USER_ID=
# Signing secret of the Stripe test-mode webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=
